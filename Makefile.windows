# Windows x86_64 Cross-Compilation Makefile
# Uses MinGW-w64 to create standalone Windows executables

CC := x86_64-w64-mingw32-g++
CXXFLAGS := -std=c++20 -Wall -Iinclude -static-libgcc -static-libstdc++
SRC_DIR := src
OBJ_DIR := build_win
BIN := aac.exe

SOURCES := $(wildcard $(SRC_DIR)/*.cpp)
OBJECTS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SOURCES))

.PHONY: all clean

all: $(BIN)

$(BIN): $(OBJECTS)
	$(CC) $(CXXFLAGS) -o $@ $^

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp | $(OBJ_DIR)
	$(CC) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

clean:
	rm -rf $(OBJ_DIR) $(BIN)
